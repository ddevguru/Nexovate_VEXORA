# CYBERTRACE AI Configuration

# Database (Leave blank or set to sqlite:///./cybertrace.db for instant local sqlite)
# PostgreSQL Example: postgresql://postgres:cybertracepass@localhost:5432/cybertrace
DATABASE_URL=sqlite:///./cybertrace.db

# JWT Security
JWT_SECRET=super-secret-cybertrace-key-change-in-production-2026

# AI Configuration (Optional: system automatically falls back to deterministic engine if blank)
GEMINI_API_KEY=
AI_PROVIDER=gemini

# Upload Limits
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Seed Credentials
ADMIN_EMAIL=admin@cybertrace.ai
ADMIN_PASSWORD=AdminPass123!
